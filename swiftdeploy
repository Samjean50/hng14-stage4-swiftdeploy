# SUBCOMMAND: validate
# ─────────────────────────────────────────────────────────────────────────────

def cmd_validate():
    manifest = None
    failures = []
    print("Running pre-flight validation checks...\n")

    print("Check 1: manifest.yaml exists and is valid YAML")
    if not os.path.exists(MANIFEST_FILE):
        print("  ✗ FAIL — manifest.yaml not found")
        failures.append("manifest.yaml missing")
    else:
        try:
            with open(MANIFEST_FILE) as f:
                manifest = yaml.safe_load(f)
            print("  ✓ PASS")
        except yaml.YAMLError as e:
            print(f"  ✗ FAIL — Invalid YAML: {e}")
            failures.append("manifest.yaml invalid YAML")

    print("\nCheck 2: Required fields present and non-empty")
    required_fields = [
        ("services", "image"), ("services", "port"),
        ("nginx", "port"), ("network", "name"), ("network", "driver_type"),
    ]
    if manifest:
        field_ok = True
        for section, field in required_fields:
            value = manifest.get(section, {}).get(field)
            if not value:
                print(f"  ✗ FAIL — Missing: {section}.{field}")
                failures.append(f"missing field {section}.{field}")
                field_ok = False
        if field_ok:
            print("  ✓ PASS")

    print("\nCheck 3: Docker image exists locally")
    if manifest:
        image = manifest.get("services", {}).get("image", "")
        result = subprocess.run(
            ["docker", "image", "inspect", image], capture_output=True
        )
        if result.returncode == 0:
            print(f"  ✓ PASS — {image} found")
        else:
            print(f"  ✗ FAIL — Image not found: {image}")
            failures.append(f"image {image} not found")

    print("\nCheck 4: Nginx port not already bound on host")
    if manifest:
        nginx_port = int(manifest.get("nginx", {}).get("port", 8080))
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(1)
        result = sock.connect_ex(("localhost", nginx_port))
        sock.close()
        if result == 0:
            print(f"  ✗ FAIL — Port {nginx_port} is already in use")
            failures.append(f"port {nginx_port} already bound")
        else:
            print(f"  ✓ PASS — Port {nginx_port} is free")

    print("\nCheck 5: nginx.conf is syntactically valid")
    if not os.path.exists(NGINX_CONF_FILE):
        print(f"  ✗ FAIL — nginx.conf not found (run swiftdeploy init first)")
        failures.append("nginx.conf missing")
    else:
        result = subprocess.run(
            ["docker", "run", "--rm",
             "-v", f"{os.getcwd()}/{NGINX_CONF_FILE}:/etc/nginx/nginx.conf:ro",
             "nginx:latest", "nginx", "-t"],
            capture_output=True, text=True
        )
        upstream_error = "host not found in upstream" in result.stderr
        if result.returncode == 0 or upstream_error:
            print("  ✓ PASS — nginx.conf syntax is valid")
        else:
            print(f"  ✗ FAIL — {result.stderr.strip()}")
            failures.append("nginx.conf syntax invalid")

    print(f"\n{'─'*40}")
    if failures:
        print(f"✗ VALIDATION FAILED — {len(failures)} check(s) failed:")
        for f in failures:
            print(f"  - {f}")
        sys.exit(1)
    else:
        print("✓ ALL CHECKS PASSED — ready to deploy")


# ─────────────────────────────────────────────────────────────────────────────
# SUBCOMMAND: deploy
# Now includes OPA pre-deploy policy check
# ─────────────────────────────────────────────────────────────────────────────

def cmd_deploy():
    print("=== SwiftDeploy Deploy ===\n")
    cmd_init()
    print()

    manifest = load_manifest()
    nginx_port = manifest.get("nginx", {}).get("port", 8080)

    # Start stack first so OPA is available for policy check
    print("→ Starting stack...")
    run(["docker", "compose", "up", "-d", "--build"])

    # Wait for OPA to be ready
    print("→ Waiting for OPA to start...")
    opa_ready = False
    for _ in range(15):
        try:
            resp = req_lib.get(f"{OPA_URL}/health", timeout=2)
            if resp.status_code == 200:
                opa_ready = True
                break
        except Exception:
            pass
        time.sleep(2)

    if not opa_ready:
        print("  ✗ OPA did not start — blocking deploy")
        run(["docker", "compose", "down"], check=False)
        sys.exit(1)

    # Run OPA pre-deploy policy check
    passed = run_policy_check("pre-deploy")
    if not passed:
        print("\n✗ DEPLOY BLOCKED by policy violation")
        print("  Fix the issues above and retry")
        append_history("deploy_blocked", {"reason": "policy_violation"})
        run(["docker", "compose", "down"], check=False)
        sys.exit(1)

    # Wait for API health check
    print("\n→ Waiting for health checks...")
    deadline = time.time() + 60
    healthy = False
    while time.time() < deadline:
        try:
            resp = req_lib.get(
                f"http://localhost:{nginx_port}/healthz", timeout=3
            )
            if resp.status_code == 200:
                data = resp.json()
                print(f"  ✓ Service healthy — mode={data.get('mode')} "
                      f"uptime={data.get('uptime_seconds')}s")
                healthy = True
                break
        except Exception:
            pass
        print(f"  … waiting ({int(deadline - time.time())}s remaining)")
        time.sleep(3)

    if not healthy:
        print("✗ DEPLOY FAILED — health check timed out")
        sys.exit(1)

    append_history("deploy_complete", {
        "mode": manifest.get("services", {}).get("mode", "stable")
    })

    print(f"\n✓ DEPLOY COMPLETE")
    print(f"  API:       http://localhost:{nginx_port}")
    print(f"  Health:    http://localhost:{nginx_port}/healthz")
    print(f"  Metrics:   http://localhost:{nginx_port}/metrics")


# ─────────────────────────────────────────────────────────────────────────────
# SUBCOMMAND: promote
# Now includes OPA pre-promote canary safety check
# ─────────────────────────────────────────────────────────────────────────────

def cmd_promote(target_mode):
    if target_mode not in ("stable", "canary"):
        print(f"ERROR: Invalid mode '{target_mode}'")
        sys.exit(1)

    print(f"=== Promoting to {target_mode} mode ===\n")
    manifest = load_manifest()
    current_mode = manifest.get("services", {}).get("mode", "stable")
    nginx_port = manifest.get("nginx", {}).get("port", 8080)

    print(f"→ Current mode: {current_mode}")
    print(f"→ Target mode:  {target_mode}")

    if current_mode == target_mode:
        print(f"  Already in {target_mode} mode")
        sys.exit(0)

    # Pre-promote check only needed when promoting TO stable
    # i.e. graduating canary to stable — verify canary is healthy first
    if target_mode == "stable" and current_mode == "canary":
        print("→ Scraping canary metrics for policy check...")
        raw_metrics = scrape_metrics(nginx_port)
        if raw_metrics:
            parsed = parse_metrics(raw_metrics)
            error_rate = calculate_error_rate(parsed)
            p99_ms = calculate_p99(parsed)
            metrics_data = {
                "error_rate": error_rate,
                "p99_latency_ms": p99_ms
            }
            passed = run_policy_check("pre-promote", metrics_data)
            if not passed:
                print("\n✗ PROMOTION BLOCKED by canary safety policy")
                print("  Canary is not healthy enough to promote to stable")
                append_history("promote_blocked", {
                    "from": current_mode,
                    "to": target_mode,
                    "error_rate": error_rate,
                    "p99_latency_ms": p99_ms
                })
                sys.exit(1)
        else:
            print("  ⚠ Could not scrape metrics — proceeding with caution")

    # Update manifest mode in-place
    print(f"\n→ Updating manifest.yaml...")
    import re
    with open(MANIFEST_FILE, "r") as f:
        content = f.read()
    content = re.sub(
        r'(  mode:\s*)\S+',
        f'\\g<1>{target_mode}',
        content
    )
    with open(MANIFEST_FILE, "w") as f:
        f.write(content)
    print(f"  ✓ manifest.yaml updated")

    print(f"→ Regenerating docker-compose.yml...")
    cmd_init()

    print(f"→ Restarting API service...")
    run(["docker", "compose", "up", "-d", "--no-deps",
         "--force-recreate", "api"])

    print(f"→ Confirming new mode...")
    deadline = time.time() + 60
    while time.time() < deadline:
        try:
            resp = req_lib.get(
                f"http://localhost:{nginx_port}/healthz", timeout=3
            )
            if resp.status_code == 200:
                data = resp.json()
                if data.get("mode") == target_mode:
                    print(f"  ✓ Mode confirmed: {data.get('mode')}")
                    if target_mode == "canary":
                        x_mode = resp.headers.get("X-Mode", "missing")
                        print(f"  ✓ X-Mode header: {x_mode}")
                    break
        except Exception:
            pass
        time.sleep(3)
    else:
        print("✗ PROMOTE FAILED — timeout")
        sys.exit(1)

    append_history("mode_change", {
        "from": current_mode,
        "to": target_mode
    })

    print(f"\n✓ PROMOTE COMPLETE — now in {target_mode} mode")


