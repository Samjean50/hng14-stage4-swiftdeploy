# SUBCOMMAND: audit
# Generates audit_report.md from history.jsonl
# ─────────────────────────────────────────────────────────────────────────────

def cmd_audit():
    """
    Generates a Markdown audit report from history.jsonl.
    Parses every event and produces:
    - Timeline table of mode changes and chaos injections
    - Violations section for any policy failures
    """
    if not os.path.exists(HISTORY_FILE):
        print(f"ERROR: {HISTORY_FILE} not found — run swiftdeploy status first")
        sys.exit(1)

    events = []
    with open(HISTORY_FILE) as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    events.append(json.loads(line))
                except json.JSONDecodeError:
                    continue

    if not events:
        print("No events found in history.jsonl")
        sys.exit(1)

    lines = []
    lines.append("# SwiftDeploy Audit Report")
    lines.append(f"\nGenerated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S UTC')}")
    lines.append(f"\nTotal events: {len(events)}")

    # --- Timeline section ---
    lines.append("\n## Timeline\n")
    lines.append("| Timestamp | Event | Details |")
    lines.append("|-----------|-------|---------|")

    for e in events:
        ts = e.get("timestamp", "")[:19].replace("T", " ")
        event = e.get("event", "")

        if event == "mode_change":
            detail = f"Mode changed: {e.get('from')} → {e.get('to')}"
        elif event == "deploy_complete":
            detail = f"Deployed in {e.get('mode', 'unknown')} mode"
        elif event == "deploy_blocked":
            detail = f"Deploy blocked: {e.get('reason', 'policy violation')}"
        elif event == "promote_blocked":
            detail = (f"Promotion blocked: error_rate="
                      f"{e.get('error_rate', 0)*100:.2f}% "
                      f"p99={e.get('p99_latency_ms', 0):.0f}ms")
        elif event == "status_scrape":
            chaos = e.get("chaos", "none")
            if chaos != "none":
                detail = (f"Chaos active: {chaos} | "
                          f"errors={e.get('error_rate', 0)*100:.1f}%")
            else:
                detail = (f"req/s={e.get('req_per_sec', 0):.2f} | "
                          f"p99={e.get('p99_latency_ms', 0):.0f}ms")
        else:
            detail = str({k: v for k, v in e.items()
                          if k not in ("timestamp", "event")})

        lines.append(f"| {ts} | {event} | {detail} |")

    # --- Violations section ---
    violations = [
        e for e in events
        if e.get("event") in ("deploy_blocked", "promote_blocked")
        or (e.get("event") == "status_scrape"
            and (e.get("infra_pass") is False
                 or e.get("canary_pass") is False))
    ]

    lines.append("\n## Policy Violations\n")
    if not violations:
        lines.append("No policy violations recorded.")
    else:
        lines.append(f"**{len(violations)} violation(s) detected**\n")
        lines.append("| Timestamp | Type | Details |")
        lines.append("|-----------|------|---------|")
        for v in violations:
            ts = v.get("timestamp", "")[:19].replace("T", " ")
            event = v.get("event", "")
            if event == "deploy_blocked":
                vtype = "Deploy Blocked"
                detail = "Infrastructure policy failed"
            elif event == "promote_blocked":
                vtype = "Promotion Blocked"
                detail = (f"error_rate={v.get('error_rate', 0)*100:.2f}% "
                          f"p99={v.get('p99_latency_ms', 0):.0f}ms")
            else:
                vtype = "Policy Failure"
                failed = []
                if v.get("infra_pass") is False:
                    failed.append("infrastructure")
                if v.get("canary_pass") is False:
                    failed.append("canary")
                detail = f"Failed: {', '.join(failed)}"
            lines.append(f"| {ts} | {vtype} | {detail} |")

    # --- Mode changes summary ---
    mode_changes = [e for e in events if e.get("event") == "mode_change"]
    lines.append("\n## Mode Changes\n")
    if not mode_changes:
        lines.append("No mode changes recorded.")
    else:
        lines.append("| Timestamp | From | To |")
        lines.append("|-----------|------|----|")
        for mc in mode_changes:
            ts = mc.get("timestamp", "")[:19].replace("T", " ")
            lines.append(
                f"| {ts} | {mc.get('from', '?')} | {mc.get('to', '?')} |"
            )

    report = "\n".join(lines) + "\n"
    with open(AUDIT_REPORT, "w") as f:
        f.write(report)

    print(f"✓ Audit report generated: {AUDIT_REPORT}")
    print(f"  Events processed: {len(events)}")
    print(f"  Violations found: {len(violations)}")
    print(f"  Mode changes:     {len(mode_changes)}")


