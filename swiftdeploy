# --- Constants ---
MANIFEST_FILE    = "manifest.yaml"
COMPOSE_FILE     = "docker-compose.yml"
NGINX_CONF_FILE  = "nginx.conf"
TEMPLATES_DIR    = "templates"
NGINX_TEMPLATE   = "nginx.conf.j2"
COMPOSE_TEMPLATE = "docker-compose.yml.j2"
OPA_URL          = "http://localhost:8181"
HISTORY_FILE     = "history.jsonl"
AUDIT_REPORT     = "audit_report.md"


def load_manifest():
    if not os.path.exists(MANIFEST_FILE):
        print(f"ERROR: {MANIFEST_FILE} not found")
        sys.exit(1)
    with open(MANIFEST_FILE) as f:
        try:
            return yaml.safe_load(f)
        except yaml.YAMLError as e:
            print(f"ERROR: Invalid YAML: {e}")
            sys.exit(1)


def run(cmd, check=True, capture=False):
    result = subprocess.run(
        cmd, check=check, capture_output=capture, text=True
    )
    if capture:
        return result.stdout.strip()
    return result


# ─────────────────────────────────────────────────────────────────────────────
# METRICS PARSING
# Parses Prometheus text format into Python dicts
# ─────────────────────────────────────────────────────────────────────────────

def scrape_metrics(port):
    """
    Scrapes /metrics endpoint and returns raw text.
    Returns None if unreachable.
    """
    try:
        resp = req_lib.get(f"http://localhost:{port}/metrics", timeout=5)
        if resp.status_code == 200:
            return resp.text
    except Exception:
        pass
    return None


def parse_metrics(text):
    """
    Parses Prometheus text format into a dict.
    Returns dict of metric_name -> list of (labels_dict, value) tuples.
    """
    metrics = {}
    for line in text.strip().split("\n"):
        if line.startswith("#") or not line.strip():
            continue
        # Match: metric_name{labels} value
        # or: metric_name value
        match = re.match(r'^(\w+)(\{[^}]*\})?\s+([\d.e+\-inf]+)$', line)
        if not match:
            continue
        name = match.group(1)
        labels_str = match.group(2) or ""
        value = float(match.group(3))

        # Parse labels into dict
        labels = {}
        if labels_str:
            for pair in re.findall(r'(\w+)="([^"]*)"', labels_str):
                labels[pair[0]] = pair[1]

        if name not in metrics:
            metrics[name] = []
        metrics[name].append((labels, value))

    return metrics


def calculate_error_rate(metrics):
    """
    Calculates error rate from http_requests_total counter.
    Error rate = error requests / total requests
    Errors are status codes 5xx.
    """
    total = 0
    errors = 0
    for labels, value in metrics.get("http_requests_total", []):
        status = labels.get("status_code", "")
        total += value
        if status.startswith("5"):
            errors += value
    if total == 0:
        return 0.0
    return errors / total


def calculate_p99(metrics):
    """
    Calculates P99 latency from histogram buckets.

    P99 means 99% of requests completed within this time.
    We find the bucket where cumulative count >= 99% of total requests.

    Prometheus histograms are cumulative — bucket le="0.1" contains
    ALL requests that completed in <= 0.1 seconds.
    """
    buckets = []
    total = 0

    for labels, value in metrics.get(
            "http_request_duration_seconds_bucket", []):
        le = labels.get("le", "")
        if le == "+Inf":
            total = value
        else:
            buckets.append((float(le), value))

    if not buckets or total == 0:
        return 0.0

    # Sort by le value ascending
    buckets.sort(key=lambda x: x[0])

    # Find the bucket where cumulative count >= 99% of total
    p99_threshold = total * 0.99
    for le, count in buckets:
        if count >= p99_threshold:
            # Convert to milliseconds
            return le * 1000

    # If no bucket covers 99%, return the max bucket * 1000
    return buckets[-1][0] * 1000


# ─────────────────────────────────────────────────────────────────────────────
# OPA POLICY CHECKING
# ─────────────────────────────────────────────────────────────────────────────

def query_opa(package: str, input_data: dict):
    """
    Queries OPA for a policy decision.

    package: e.g. "swiftdeploy/infrastructure"
    input_data: the context data to evaluate against the policy

    Returns dict with keys: allow (bool), reasons (list of strings)
    Returns None if OPA is unreachable.

    The CLI never makes allow/deny decisions itself —
    all logic lives in OPA Rego files.
    """
    url = f"{OPA_URL}/v1/data/{package}"
    try:
        resp = req_lib.post(
            url,
            json={"input": input_data},
            timeout=5
        )
        if resp.status_code == 200:
            result = resp.json().get("result", {})
            return {
                "allow": result.get("allow", False),
                "reasons": list(result.get("reasons", []))
            }
        else:
            return None
    except req_lib.exceptions.ConnectionError:
        # OPA is not running
        return {"error": "OPA unavailable — connection refused"}
    except req_lib.exceptions.Timeout:
        # OPA is too slow
        return {"error": "OPA unavailable — request timed out"}
    except Exception as e:
        # Any other failure
        return {"error": f"OPA query failed: {str(e)}"}


def get_host_stats():
    """
    Collects host system stats for infrastructure policy check.
    Uses only Python standard library — no psutil required.
    """
    import shutil

    # Disk free in GB
    disk = shutil.disk_usage("/")
    disk_free_gb = disk.free / (1024 ** 3)

    # CPU load (1 minute average)
    try:
        cpu_load = os.getloadavg()[0]
    except AttributeError:
        # Windows doesn't have getloadavg
        cpu_load = 0.0

    # Memory free percent
    try:
        with open("/proc/meminfo") as f:
            meminfo = f.read()
        mem_total = int(re.search(r"MemTotal:\s+(\d+)", meminfo).group(1))
        mem_available = int(
            re.search(r"MemAvailable:\s+(\d+)", meminfo).group(1)
        )
        mem_free_percent = (mem_available / mem_total) * 100
    except Exception:
        # Mac doesn't have /proc/meminfo
        mem_free_percent = 50.0

    return {
        "disk_free_gb": round(disk_free_gb, 2),
        "cpu_load": round(cpu_load, 3),
        "mem_free_percent": round(mem_free_percent, 1)
    }


def run_policy_check(check_type: str, extra_data: dict = None):
    """
    Runs all relevant policy checks for the given lifecycle event.
    check_type: "pre-deploy" or "pre-promote"

    Returns True if all policies pass, False if any fail.
    Prints clear pass/fail for each policy with reasoning.
    """
    print(f"\n→ Running OPA policy checks ({check_type})...")

    all_passed = True

    if check_type == "pre-deploy":
        # Infrastructure check — is the host healthy enough?
        stats = get_host_stats()
        print(f"  Host stats: disk={stats['disk_free_gb']}GB free, "
              f"cpu={stats['cpu_load']}, mem={stats['mem_free_percent']}% free")

        result = query_opa("swiftdeploy/infrastructure", stats)

        if result is None:
            print("  ⚠ Infrastructure policy: OPA returned unexpected response")
            all_passed = False
        elif "error" in result:
            # OPA unavailable — fail safe, block deploy
            print(f"  ✗ Infrastructure policy: {result['error']}")
            print("    Blocking deploy — cannot verify host safety without OPA")
            all_passed = False
        elif result["allow"]:
            print("  ✓ Infrastructure policy: PASS — host is healthy")
        else:
            print("  ✗ Infrastructure policy: FAIL")
            for reason in result.get("reasons", ["No reason provided"]):
                print(f"    → {reason}")
            all_passed = False

    elif check_type == "pre-promote":
        # Canary safety check — is the canary healthy enough to promote?
        if not extra_data:
            print("  ✗ Canary policy: No metrics data provided")
            return False

        print(f"  Canary metrics: error_rate={extra_data.get('error_rate', 0)*100:.2f}%, "
              f"p99={extra_data.get('p99_latency_ms', 0):.0f}ms")

        result = query_opa("swiftdeploy/canary", extra_data)

        if result is None:
            print("  ⚠ Canary policy: OPA returned unexpected response")
            all_passed = False
        elif "error" in result:
            print(f"  ✗ Canary policy: {result['error']}")
            print("    Blocking promotion — cannot verify canary health without OPA")
            all_passed = False
        elif result["allow"]:
            print("  ✓ Canary policy: PASS — canary is healthy")
        else:
            print("  ✗ Canary policy: FAIL")
            for reason in result.get("reasons", ["No reason provided"]):
                print(f"    → {reason}")
            all_passed = False

    return all_passed


# ─────────────────────────────────────────────────────────────────────────────
# AUDIT TRAIL
# ─────────────────────────────────────────────────────────────────────────────

def append_history(event_type: str, data: dict):
    """
    Appends one JSON line to history.jsonl for the audit trail.
    JSONL = one JSON object per line — easy to parse and append to.
    """
    entry = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "event": event_type,
        **data
    }
    with open(HISTORY_FILE, "a") as f:
        f.write(json.dumps(entry) + "\n")


