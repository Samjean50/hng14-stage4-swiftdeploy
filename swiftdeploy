# SUBCOMMAND: status
# Live terminal dashboard — scrapes /metrics every 3 seconds
# ─────────────────────────────────────────────────────────────────────────────

def cmd_status():
    """
    Live terminal dashboard that refreshes every 3 seconds.
    Shows real-time metrics and OPA policy compliance.
    Appends every scrape to history.jsonl for the audit trail.
    Press Ctrl+C to exit.
    """
    manifest = load_manifest()
    nginx_port = manifest.get("nginx", {}).get("port", 8080)

    print("SwiftDeploy Status Dashboard")
    print("Press Ctrl+C to exit\n")

    prev_request_counts = {}
    prev_time = time.time()

    try:
        while True:
            now = time.time()
            elapsed = now - prev_time

            # Clear screen
            os.system("clear" if os.name == "posix" else "cls")

            print("╔══════════════════════════════════════════════╗")
            print("║       SwiftDeploy Live Status Dashboard      ║")
            print(f"║  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}                        ║")
            print("╚══════════════════════════════════════════════╝\n")

            # Scrape metrics
            raw = scrape_metrics(nginx_port)
            if not raw:
                print("✗ Cannot reach /metrics — is the stack running?")
                time.sleep(3)
                continue

            parsed = parse_metrics(raw)

            # Calculate req/s
            current_total = sum(
                v for _, v in parsed.get("http_requests_total", [])
            )
            prev_total = sum(prev_request_counts.values()) if prev_request_counts else current_total
            req_per_sec = max(0, (current_total - prev_total) / elapsed) if elapsed > 0 else 0

            # Calculate error rate and P99
            error_rate = calculate_error_rate(parsed)
            p99_ms = calculate_p99(parsed)

            # Get mode and chaos state
            mode_val = next(
                (v for _, v in parsed.get("app_mode", [])), 0
            )
            chaos_val = next(
                (v for _, v in parsed.get("chaos_active", [])), 0
            )
            uptime = next(
                (v for _, v in parsed.get("app_uptime_seconds", [])), 0
            )

            mode_str = "canary" if mode_val == 1 else "stable"
            chaos_map = {0: "none", 1: "slow", 2: "error"}
            chaos_str = chaos_map.get(int(chaos_val), "unknown")

            # Display metrics
            print("── Service State ──────────────────────────────")
            print(f"  Mode:        {mode_str}")
            print(f"  Uptime:      {int(uptime)}s")
            print(f"  Chaos:       {chaos_str}")
            print()
            print("── Traffic ─────────────────────────────────────")
            print(f"  Req/s:       {req_per_sec:.2f}")
            print(f"  Total reqs:  {int(current_total)}")
            print(f"  Error rate:  {error_rate*100:.2f}%")
            print(f"  P99 latency: {p99_ms:.0f}ms")
            print()

            # OPA Policy Compliance
            print("── Policy Compliance ───────────────────────────")

            # Check infrastructure policy
            stats = get_host_stats()
            infra_result = query_opa("swiftdeploy/infrastructure", stats)
            if infra_result and "error" not in infra_result:
                status = "✓ PASS" if infra_result["allow"] else "✗ FAIL"
                print(f"  Infrastructure: {status}")
                if not infra_result["allow"]:
                    for r in infra_result.get("reasons", []):
                        print(f"    → {r}")
            else:
                err = infra_result.get("error", "unknown") if infra_result else "OPA unreachable"
                print(f"  Infrastructure: ⚠ {err}")

            # Check canary policy with current metrics
            canary_data = {"error_rate": error_rate, "p99_latency_ms": p99_ms}
            canary_result = query_opa("swiftdeploy/canary", canary_data)
            if canary_result and "error" not in canary_result:
                status = "✓ PASS" if canary_result["allow"] else "✗ FAIL"
                print(f"  Canary safety:  {status}")
                if not canary_result["allow"]:
                    for r in canary_result.get("reasons", []):
                        print(f"    → {r}")
            else:
                err = canary_result.get("error", "unknown") if canary_result else "OPA unreachable"
                print(f"  Canary safety:  ⚠ {err}")

            print()
            print("  Press Ctrl+C to exit")

            # Append to history.jsonl for audit trail
            history_entry = {
                "mode": mode_str,
                "chaos": chaos_str,
                "req_per_sec": round(req_per_sec, 3),
                "error_rate": round(error_rate, 4),
                "p99_latency_ms": round(p99_ms, 1),
                "total_requests": int(current_total),
                "infra_pass": infra_result.get("allow", False) if infra_result and "error" not in infra_result else None,
                "canary_pass": canary_result.get("allow", False) if canary_result and "error" not in canary_result else None,
            }
            append_history("status_scrape", history_entry)

            # Update previous counters for req/s calculation
            prev_request_counts = {
                str(labels): val
                for labels, val in parsed.get("http_requests_total", [])
            }
            prev_time = now

            time.sleep(3)

    except KeyboardInterrupt:
        print("\n\nStatus dashboard stopped.")


