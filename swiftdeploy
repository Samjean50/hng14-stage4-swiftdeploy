def cmd_teardown(clean=False):
    print("=== SwiftDeploy Teardown ===\n")
    print("→ Stopping and removing containers, networks, volumes...")
    run(["docker", "compose", "down", "--volumes", "--remove-orphans"])
    print("  ✓ Stack removed")
    if clean:
        for f in [COMPOSE_FILE, NGINX_CONF_FILE]:
            if os.path.exists(f):
                os.remove(f)
                print(f"  ✓ Deleted {f}")
    print("\n✓ TEARDOWN COMPLETE")


# ─────────────────────────────────────────────────────────────────────────────
# Entry point
# ─────────────────────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) < 2:
        print("SwiftDeploy — declarative deployment tool")
        print("\nUsage: ./swiftdeploy <subcommand> [options]")
        print("\nSubcommands:")
        print("  init                  Generate nginx.conf and docker-compose.yml")
        print("  validate              Run pre-flight checks")
        print("  deploy                Init + start stack + OPA policy gate + health check")
        print("  promote <mode>        Switch to stable or canary (with OPA gate)")
        print("  status                Live metrics dashboard with policy compliance")
        print("  audit                 Generate audit_report.md from history")
        print("  teardown [--clean]    Remove stack")
        sys.exit(1)

    subcommand = sys.argv[1]

    if subcommand == "init":
        cmd_init()
    elif subcommand == "validate":
        cmd_validate()
    elif subcommand == "deploy":
        cmd_deploy()
    elif subcommand == "promote":
        if len(sys.argv) < 3:
            print("Usage: ./swiftdeploy promote <stable|canary>")
            sys.exit(1)
        cmd_promote(sys.argv[2])
    elif subcommand == "status":
        cmd_status()
    elif subcommand == "audit":
        cmd_audit()
    elif subcommand == "teardown":
        clean = "--clean" in sys.argv
        cmd_teardown(clean=clean)
    else:
        print(f"ERROR: Unknown subcommand '{subcommand}'")
        sys.exit(1)


if __name__ == "__main__":
    main()
