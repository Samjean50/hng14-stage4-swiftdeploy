# nginx.conf — GENERATED by swiftdeploy init
# Do not edit manually — changes will be overwritten
# Edit manifest.yaml instead

events {
    worker_connections 1024;
}

http {
    # Access log format required by the task spec
    log_format swiftdeploy '$time_iso8601 | $status | ${request_time}s | $upstream_addr | $request';

    # Upstream block — points to the API service container
    upstream api_service {
        server api:{{ services.port }};
    }

    server {
        listen 80;
        server_name _;

        access_log /var/log/nginx/access.log swiftdeploy;

        # Proxy timeouts from manifest
        proxy_connect_timeout {{ nginx.proxy_timeout }}s;
        proxy_send_timeout    {{ nginx.proxy_timeout }}s;
        proxy_read_timeout    {{ nginx.proxy_timeout }}s;

        # Add SwiftDeploy identifier header to every response
        add_header X-Deployed-By swiftdeploy always;

        location / {
            proxy_pass http://api_service;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

            # Forward X-Mode header from upstream to client
            proxy_pass_header X-Mode;
        }

        # JSON error bodies for gateway errors
        error_page 502 = @error502;
        error_page 503 = @error503;
        error_page 504 = @error504;

        location @error502 {
            default_type application/json;
            add_header X-Deployed-By swiftdeploy always;
            return 502 '{"error":"Bad Gateway","code":502,"service":"api","contact":"ops@swiftdeploy.io"}';
        }

        location @error503 {
            default_type application/json;
            add_header X-Deployed-By swiftdeploy always;
            return 503 '{"error":"Service Unavailable","code":503,"service":"api","contact":"ops@swiftdeploy.io"}';
        }

        location @error504 {
            default_type application/json;
            add_header X-Deployed-By swiftdeploy always;
            return 504 '{"error":"Gateway Timeout","code":504,"service":"api","contact":"ops@swiftdeploy.io"}';
        }
    }
}
