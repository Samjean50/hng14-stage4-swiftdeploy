# docker-compose.yml — GENERATED by swiftdeploy init
# Do not edit manually — changes will be overwritten
# Edit manifest.yaml instead

networks:
  {{ network.name }}:
    driver: {{ network.driver_type }}

volumes:
  {{ volumes.logs }}:
    driver: local

services:

  api:
    image: {{ services.image }}
    networks:
      - {{ network.name }}
    environment:
      # Injected from manifest — controls service behaviour
      - MODE={{ services.mode }}
      - APP_VERSION={{ services.version }}
      - APP_PORT={{ services.port }}
    volumes:
      - {{ volumes.logs }}:/var/log/app
    restart: {{ services.restart }}
    # Service port is NOT exposed to the host
    # All traffic routes through Nginx
    expose:
      - "{{ services.port }}"
    # Drop all Linux capabilities then add back only what's needed
    # This follows the principle of least privilege
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD-SHELL", "python3 -c \"import urllib.request; urllib.request.urlopen('http://localhost:{{ services.port }}/healthz')\" || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

  nginx:
    image: {{ nginx.image }}
    networks:
      - {{ network.name }}
    ports:
      - "{{ nginx.port }}:80"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - /dev/null:/etc/nginx/conf.d/default.conf:ro
      - {{ volumes.logs }}:/var/log/nginx
    depends_on:
      api:
        condition: service_healthy
    restart: {{ services.restart }}
    security_opt:
      - no-new-privileges:true      
